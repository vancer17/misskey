{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"types": ["node", "vite/client", "vite-plugin-glsl/ext", "vitest/importMeta"]
	},
	"include": [
		"./build-community-app.ts",
		"./verify-community-app.ts",
		"./vite.community-app.config.ts",
		"./vitest.config.community-app.ts",
		"./lib/vite-shared-config.ts",
