{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["node"],
		"lib": ["ES2022", "DOM"]
	},
	"include": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
}
